            "name": "X-Office-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Tenant office identifier"
          },
          {
            "name": "caseId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Case identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested case",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CaseModel" }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Case not found" }
        }
      },
      "delete": {
        "tags": ["Case"],
        "summary": "Delete a case",
        "operationId": "deleteCase",
