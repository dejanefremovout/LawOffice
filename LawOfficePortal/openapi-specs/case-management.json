  "components": {
    "schemas": {
      "CaseModel": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "officeId": { "type": "string" },
          "clientIds": { "type": "array", "items": { "type": "string" } },
          "opposingPartyIds": { "type": "array", "items": { "type": "string" } },
          "identificationNumber": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "active": { "type": "boolean" },
          "competentCourt": { "type": "string", "nullable": true },
          "city": { "type": "string", "nullable": true },
          "year": { "type": "integer", "format": "int32", "nullable": true },
          "judge": { "type": "string", "nullable": true }
        }
      },
      "CaseCreateModel": {
        "type": "object",
        "required": ["officeId", "clientIds", "opposingPartyIds", "identificationNumber"],
        "properties": {
          "officeId": { "type": "string" },
          "clientIds": { "type": "array", "items": { "type": "string" } },
          "opposingPartyIds": { "type": "array", "items": { "type": "string" } },
          "identificationNumber": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "competentCourt": { "type": "string", "nullable": true },
          "city": { "type": "string", "nullable": true },
          "year": { "type": "integer", "format": "int32", "nullable": true },
          "judge": { "type": "string", "nullable": true }
        }
      },
      "CaseCountModel": {
        "type": "object",
        "properties": {
          "totalCases": { "type": "integer", "format": "int32" },
          "activeCases": { "type": "integer", "format": "int32" }
        }
      },
      "CaseHearingModel": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "identificationNumber": { "type": "string" },
          "date": { "type": "string", "format": "date-time" }
        }
      },
      "HearingModel": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "caseId": { "type": "string" },
          "officeId": { "type": "string" },
          "courtroom": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "date": { "type": "string", "format": "date-time" },
          "held": { "type": "boolean" }
        }
      },
      "HearingCreateModel": {
        "type": "object",
        "properties": {
          "caseId": { "type": "string" },
          "officeId": { "type": "string" },
          "courtroom": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "date": { "type": "string", "format": "date-time" },
          "held": { "type": "boolean" }
        }
      },
      "DocumentFileModel": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "caseId": { "type": "string" },
          "officeId": { "type": "string" },
          "name": { "type": "string" },
          "uri": { "type": "string", "format": "uri", "nullable": true }
        }
      },
      "DocumentFileCreateModel": {
        "type": "object",
        "properties": {
          "caseId": { "type": "string" },
          "officeId": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    }
